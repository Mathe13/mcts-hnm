<mxfile host="drawio" version="24.7.17">
  <diagram id="mcts-hnm-method" name="MCTS-HNM training step">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Panel: class hierarchy -->
        <mxCell id="treePanel" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F7F9FC;strokeColor=#6C8EBF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="treeTitle" value="&lt;b&gt;Negative class hierarchy 𝒯&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;semantic: 20 superclasses × 5 classes (target class excluded)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="360" height="40" as="geometry" />
        </mxCell>

        <mxCell id="root" value="root" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E99;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="185" y="80" width="70" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sc1" value="fruit &amp;amp; veg." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E99;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="45" y="160" width="100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sc2" value="aquatic mammals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="170" y="160" width="100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sc3" value="… (18 more)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="295" y="160" width="100" height="32" as="geometry" />
        </mxCell>

        <mxCell id="lf1" value="orange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="60" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lf2" value="&lt;b&gt;pear&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="60" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lf3" value="beaver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="170" y="240" width="60" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lf4" value="dolphin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="240" width="60" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lfLabel" value="leaf &lt;i&gt;l&lt;/i&gt;" style="text;html=1;align=center;fontSize=11;fontColor=#B36B00;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="270" width="60" height="18" as="geometry" />
        </mxCell>

        <mxCell id="e_r_s1" style="endArrow=classic;html=1;strokeColor=#1F4E99;strokeWidth=3;" edge="1" parent="1" source="root" target="sc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r_s2" style="endArrow=none;html=1;strokeColor=#AAAAAA;" edge="1" parent="1" source="root" target="sc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r_s3" style="endArrow=none;html=1;strokeColor=#AAAAAA;dashed=1;" edge="1" parent="1" source="root" target="sc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s1_l1" style="endArrow=none;html=1;strokeColor=#AAAAAA;" edge="1" parent="1" source="sc1" target="lf1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s1_l2" style="endArrow=classic;html=1;strokeColor=#1F4E99;strokeWidth=3;" edge="1" parent="1" source="sc1" target="lf2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s2_l3" style="endArrow=none;html=1;strokeColor=#AAAAAA;" edge="1" parent="1" source="sc2" target="lf3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s2_l4" style="endArrow=none;html=1;strokeColor=#AAAAAA;" edge="1" parent="1" source="sc2" target="lf4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ucb" value="&lt;b&gt;① Selection&lt;/b&gt;: at each node pick the child maximizing&lt;br&gt;&lt;i&gt;U&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; = &lt;i&gt;Q&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; + &lt;i&gt;c&lt;/i&gt;·√( ln &lt;i&gt;N&lt;sub&gt;s&lt;/sub&gt;&lt;/i&gt; / &lt;i&gt;n&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; ),  &lt;i&gt;c&lt;/i&gt; = 2&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Enhanced: &lt;i&gt;Q&lt;/i&gt; min–max normalized among siblings)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="292" width="375" height="52" as="geometry" />
        </mxCell>

        <!-- Sampling -->
        <mxCell id="neg" value="&lt;b&gt;② Negative sampling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Strict: 48 images from leaf &lt;i&gt;l&lt;/i&gt;&lt;br&gt;Enhanced: 24 from &lt;i&gt;l&lt;/i&gt; + 24 uniform (β = 0.5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="67" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pos" value="&lt;b&gt;Positives&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;16 per batch, drawn from the&lt;br&gt;retained target images (e.g. 9 at 2%)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="180" width="240" height="62" as="geometry" />
        </mxCell>
        <mxCell id="batch" value="&lt;b&gt;Batch&lt;/b&gt;&lt;br&gt;16 + 48" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="130" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- Model step -->
        <mxCell id="model" value="&lt;b&gt;③ Model step&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ResNet-18 (frozen in Tier 1,&lt;br&gt;fine-tuned in Tier 2)&lt;br&gt;→ MLP 512→128→1 → BCE&lt;br&gt;Adam update on the full batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="110" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Reward and backprop -->
        <mxCell id="reward" value="&lt;b&gt;④ Reward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;r&lt;/i&gt; = mean BCE on the negatives mined from &lt;i&gt;l&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="270" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="&lt;b&gt;⑤ Value backup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;leaf: &lt;i&gt;Q&lt;sub&gt;l&lt;/sub&gt;&lt;/i&gt; ← α&lt;i&gt;r&lt;/i&gt; + (1−α) &lt;i&gt;Q&lt;sub&gt;l&lt;/sub&gt;&lt;/i&gt;,  α = 0.3&lt;br&gt;ancestors: count-weighted mean of children; visit counts +1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="270" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Flow edges -->
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="treePanel" target="neg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="neg" target="batch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="pos" target="batch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="batch" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="per-example losses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="model" target="reward"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="reward" target="backup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#B85450;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="backup" target="treePanel"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="lblSel" value="selected leaf &lt;i&gt;l&lt;/i&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="425" y="80" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lblUpd" value="updated &lt;i&gt;Q&lt;/i&gt;, &lt;i&gt;n&lt;/i&gt;" style="text;html=1;align=center;fontSize=11;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="425" y="280" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="loopNote" value="repeated every optimizer step (1,000 steps per run)" style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="530" y="345" width="620" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
